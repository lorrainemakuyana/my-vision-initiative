# Copy to .env and fill in. See docs/NOTION_SETUP.md for the news section.

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_INSTAGRAM=
NEXT_PUBLIC_CONTACT_FACEBOOK=
NEXT_PUBLIC_CONTACT_TWITTER=
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=

# Social Media URLs
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_WHATSAPP_URL=

# Contact form (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL=

# News section (Notion)
# Integration secret from https://www.notion.so/my-integrations
NOTION_TOKEN=
# The 32-character ID in your Notion database URL
NOTION_DATABASE_ID=
# Any long random string; authorises POST /api/revalidate
REVALIDATE_SECRET=
